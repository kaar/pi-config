#!/usr/bin/env bash
set -o errexit
set -o nounset
set -o pipefail

# Emits the git context that pi-ai-commit feeds to the model.
# Run standalone to inspect the output.
#
# With --am/--amend, the diff is taken against HEAD^ so it includes the
# previous commit's changes (the ones being amended) plus staged changes.

AMEND=0
case "${1:-}" in
  --am | --amend) AMEND=1 ;;
esac

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# In amend mode diff against the parent of HEAD (or the empty tree for a
# root commit) so the previous commit's changes are part of the diff.
DIFF_ARGS=(--cached)
if [[ "$AMEND" -eq 1 ]]; then
  BASE="$(git rev-parse --verify --quiet HEAD^ || git hash-object -t tree /dev/null)"
  DIFF_ARGS+=("$BASE")
fi

# Max diff lines per file before truncation (override via env).
MAX_DIFF_LINES="${PI_AI_COMMIT_MAX_DIFF_LINES:-200}"

# Truncate stdin to MAX_DIFF_LINES lines. awk reads all input, so this is
# safe under pipefail (head would exit early and trigger SIGPIPE).
truncate_diff() {
  awk -v max="$MAX_DIFF_LINES" '
    NR <= max { print }
    NR == max + 1 { print "... [truncated: diff exceeds " max " lines]" }
  '
}

# Emit the staged diff file by file, truncating each file individually so
# one huge file (e.g. a lockfile) cannot crowd out the rest.
build_staged_diff() {
  local file
  while IFS= read -r -d '' file; do
    git diff "${DIFF_ARGS[@]}" -- ":(top,literal)$file" | truncate_diff
  done < <(git diff "${DIFF_ARGS[@]}" --name-only -z)
}

build_context() {
  if [[ "$AMEND" -eq 1 ]]; then
    echo "# Amending previous commit"
    echo "The diff below combines the previous commit's changes with the staged changes."
    echo
    echo "# Previous commit message"
    echo "git log -1 --format=%B"
    echo '```'
    git log -1 --format=%B
    echo '```'
    echo
  fi
  echo "# Staged files"
  echo "git diff ${DIFF_ARGS[*]} --name-status"
  echo '```sh'
  git diff "${DIFF_ARGS[@]}" --name-status
  echo '```'
  echo
  echo "# Staged changes"
  echo "git diff ${DIFF_ARGS[*]}"
  echo '```diff'
  build_staged_diff
  echo '```'
  echo
  echo "# Current branch"
  echo "git branch --show-current"
  echo '```sh'
  git branch --show-current
  echo '```'
  echo
  echo "# Recent commits"
  echo "git log --oneline -5"
  echo '```sh'
  git log --oneline -5 2>/dev/null || echo "(no commits yet)"
  echo '```'
  echo
  # Agent sessions that edited the staged files, with user intent. Prints
  # nothing when no session matches; never let it break context generation.
  #
  # I has to disable it as it started to fail producing correct commit format.
  # It could probably be fixed by improving the output from find-session-context
  # "$SCRIPT_DIR/find-session-context" 2>/dev/null || true
}

build_context
