#!/usr/bin/env bash
set -o errexit
set -o nounset
set -o pipefail

# Context building lives in create-commit-context (run it standalone to
# inspect what the model sees).
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
MODEL=claude-haiku-4-5

AMEND=""
case "${1:-}" in
  --am | --amend) AMEND="--amend" ;;
  "") ;;
  *)
    echo "Usage: pi-ai-commit [--am|--amend]" >&2
    exit 1
    ;;
esac

if [[ -n "$AMEND" ]]; then
  git rev-parse --verify --quiet HEAD >/dev/null ||
    { echo "No commit to amend." >&2; exit 1; }
elif git diff --cached --quiet 2>/dev/null; then
  echo "No staged changes found." >&2
  exit 1
fi

# The skill command must lead the message: pi prepends piped stdin to any
# -p argument, and /skill: only expands at the head of the message.
{
  printf '/skill:commit-message '
  "$SCRIPT_DIR/create-commit-context" ${AMEND:+"$AMEND"}
} |
  pi -p --model "$MODEL" --thinking off |
  git commit --edit ${AMEND:+"$AMEND"} -F -
