#!/usr/bin/env bash
set -o errexit
set -o nounset
set -o pipefail

# Context building lives in pi-ai-commit-context (run it standalone to
# inspect what the model sees).
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

if git diff --cached --quiet 2>/dev/null; then
  echo "No staged changes found." >&2
  exit 1
fi

# The skill command must lead the message: pi prepends piped stdin to any
# -p argument, and /skill: only expands at the head of the message.
{
  printf '/skill:commit-message '
  "$SCRIPT_DIR/pi-ai-commit-context"
} |
  pi -p --model claude-opus-5 --thinking off |
  fmt |
  git commit --edit -F -
